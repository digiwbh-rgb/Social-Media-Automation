# ── Anthropic / Claude ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6          # optional; this is the default
CLAUDE_MAX_TOKENS=1024                  # optional

# ── Twitter / X ────────────────────────────────────────────────────────────
# Create an app at https://developer.twitter.com/en/portal/dashboard
# Requires Elevated access (or Basic for v2 write endpoints)
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret
TWITTER_BEARER_TOKEN=your_bearer_token  # optional; needed for read endpoints

# ── LinkedIn ───────────────────────────────────────────────────────────────
# Create an app at https://www.linkedin.com/developers/apps
# Required OAuth scopes: w_member_social, openid, profile
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
LINKEDIN_ACCESS_TOKEN=your_access_token   # obtained via OAuth 2.0 flow
LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXX

# ── App settings ───────────────────────────────────────────────────────────
DB_PATH=~/.social_media_automation/posts.db   # optional
SCHEDULER_INTERVAL=60                          # seconds between scheduler polls
